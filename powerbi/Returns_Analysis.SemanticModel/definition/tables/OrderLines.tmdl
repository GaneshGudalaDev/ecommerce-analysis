	partition OrderLines = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "order_lines.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"invoice_no", type text}, {"invoice_date", type date}, {"line_type", type text}, {"stock_code", type text}, {"quantity", Int64.Type}, {"unit_price", Currency.Type}, {"line_value", Currency.Type}, {"customer_id", type text}, {"country", type text}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
