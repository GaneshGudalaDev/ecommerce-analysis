table Customers
	lineageTag: 292af5cd-3b2b-57b5-b4fe-72a160c3f6b3

	column customer_id
		dataType: string
		lineageTag: 39239b5c-73de-58e0-8f1d-f84050eaa56b
		summarizeBy: none
		sourceColumn: customer_id

		annotation SummarizationSetBy = Automatic

	column country
		dataType: string
		isHidden
		lineageTag: 534db495-a7fd-520c-98b4-2bc23fa14726
		summarizeBy: none
		sourceColumn: country

		annotation SummarizationSetBy = Automatic

	column first_purchase_date
		dataType: dateTime
		formatString: dd-mmm-yyyy
		lineageTag: 0c83458b-fa4b-5e38-91e4-d84e953c232f
		summarizeBy: none
		sourceColumn: first_purchase_date

		annotation SummarizationSetBy = Automatic

	partition Customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "customers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"customer_id", type text}, {"country", type text}, {"first_purchase_date", type date}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
