table Products
	lineageTag: e30d7507-371e-58e6-b14a-5659a46c660e

	column stock_code
		dataType: string
		lineageTag: b49cfd01-4f18-5dc7-b340-b18373b61582
		summarizeBy: none
		sourceColumn: stock_code

		annotation SummarizationSetBy = Automatic

	column description
		dataType: string
		lineageTag: 91120448-8c94-5f0e-950e-c4b99bf460fe
		summarizeBy: none
		sourceColumn: description

		annotation SummarizationSetBy = Automatic

	column category
		dataType: string
		lineageTag: 01cc2d6c-ad16-5f96-8aa5-5466b3615304
		summarizeBy: none
		sourceColumn: category

		annotation SummarizationSetBy = Automatic

	partition Products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "products.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"stock_code", type text}, {"description", type text}, {"category", type text}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
